# Azure GPT Image 2 for image creation and editing.
# Server only: never put the API key in Angular source. Restart the API after changing .env.
# Accepts the resource URL, /openai/v1/, or the full image-generation endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/images/generations
# Use the deployment name from Azure, which may differ from the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_API_KEY=
